{
  "name": "@ishizakahiroshi/vite-plugin-git-version",
  "version": "0.1.0",
  "description": "Resolve app version from git tags (git describe --tags --match v*) and inject it into Vite builds as __APP_VERSION__.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "author": "Hiroshi Ishizaka (ishizakahiroshi) <ishizakahiroshi.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishizakahiroshi/vite-plugin-git-version.git"
  },
  "bugs": {
    "url": "https://github.com/ishizakahiroshi/vite-plugin-git-version/issues"
  },
  "homepage": "https://github.com/ishizakahiroshi/vite-plugin-git-version#readme",
  "keywords": [
    "vite",
    "vite-plugin",
    "version",
    "git",
    "git-describe",
    "app-version",
    "release"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "~5.6.0",
    "vite": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
